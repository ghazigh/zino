# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env

# --- Pinned upstream ---------------------------------------------------------
ZINO_OPENWEBUI_VERSION=v0.9.6

# --- Secrets (generate, do not invent) ---------------------------------------
# Both of these: openssl rand -hex 32
WEBUI_SECRET_KEY=
# Shared between Open WebUI and the ZINO gateway; it is the gateway's API key.
ZINO_API_KEY=
POSTGRES_PASSWORD=zino-local-dev

# --- Model provider the ZINO agents call -------------------------------------
ZINO_UPSTREAM_BASE_URL=https://api.openai.com/v1
ZINO_UPSTREAM_API_KEY=
ZINO_UPSTREAM_MODEL=gpt-4o-mini

# --- Optional ----------------------------------------------------------------
ZINO_LOG_LEVEL=INFO
ENABLE_OLLAMA_API=false
