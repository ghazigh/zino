# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env

# --- Pinned upstream ---------------------------------------------------------
ZINO_OPENWEBUI_VERSION=v0.9.6

# --- Secrets (generate, do not invent) ---------------------------------------
# make secrets  — or: openssl rand -hex 32
WEBUI_SECRET_KEY=
POSTGRES_PASSWORD=zino-local-dev

# --- Optional ----------------------------------------------------------------
ENABLE_OLLAMA_API=false

# Model provider API keys do NOT go here. Add them in the ZINO admin UI
# (Admin Panel -> Settings -> Connections); they are stored in the database.
